{
  "packageVersion": "trackb-spa-package-v1",
  "entryName": "BeeTrust Honey Export Release Desk",
  "track": "B",
  "subTrack": "SP-A",
  "theme": "Commerce",
  "scenario": "Cross-border Mānuka honey export release and broker hand-off",
  "representativeEnterprise": "New Zealand honey exporter and broker workflow (synthetic demonstrator)",
  "communicationSchema": "SkillMessage/v1",
  "evidenceSources": "evidence-source-register.json",
  "knowledge": "knowledge",
  "publicMaterials": [
    "public-materials/BeeTrust_TrackB_E2E_Demo_2026-09-19-feedback.pptx",
